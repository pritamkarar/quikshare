{
  "id": "/",
  "name": "Quik Share",
  "short_name": "Quik Share",
  "description": "Send files between two devices with a link or a QR code. Nothing is stored.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#ebe9e4",
  "background_color": "#ebe9e4",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["*/*"] }]
    }
  },
  "shortcuts": [
    { "name": "Send a file", "url": "/new" },
    { "name": "Enter a code", "url": "/join" }
  ]
}
